    "SOLV-63" [label="SOLV-63\nUne zone sans terme est SILENCIEUSEMENT exemptée — sans cons", shape=octagon, color="#1b5e20", penwidth=1.6];
    "SOLV-64" [label="SOLV-64\nLe piège du « booléen trivial » — une somme sur zéro paire r", shape=octagon, color="#1b5e20", penwidth=1.6];
    "SOLV-70" [label="SOLV-70\nLe solve NE DOIT PAS être exécuté en arrière-plan derrière u", shape=octagon, color="#1b5e20", penwidth=1.6];
    "SOLV-71" [label="SOLV-71\n`zone_filter` permet des expériences en secondes : un run Ma", shape=box, color="#1b5e20", penwidth=1.6];
    "SOLV-72" [label="SOLV-72\n`scale_territorial_bounds` est OPT-IN parce que réécrire un ", shape=box, color="#1b5e20", penwidth=1.6];
    "SOLV-B5" [label="SOLV-B5\nBRANCHE COUPÉE — l'interface persistante APPSI, testée puis ", shape=box, color="#b71c1c", penwidth=1.6];
    "SOLV-73" [label="SOLV-73\nUn run réduit peut mesurer un gain qui n'existe pas à pleine", shape=component, color="#1b5e20", penwidth=1.6];
    "SOLV-74" [label="SOLV-74\n`solver.py` charge désormais l'incumbent sur `maxTimeLimit` ", shape=box, color="#1b5e20", penwidth=1.6];
    "SOLV-75" [label="SOLV-75\nLe solve tenait en 140-175 s en juillet, contre 30-55 min po", shape=ellipse, color="#1b5e20", penwidth=1.6];
    "SOLV-76" [label="SOLV-76\nUn point de balayage a tapé la limite d'une heure et rend un", shape=octagon, color="#1b5e20", penwidth=1.6];
    "SOLV-80" [label="SOLV-80\nPOURQUOI un amorçage accélère — le branch-and-bound élague u", shape=note, color="#1b5e20", penwidth=1.6];
    "SOLV-81" [label="SOLV-81\nL'AUDIT A ATTRAPÉ UNE VRAIE FAUTE — la réparation par défaut", shape=ellipse, color="#1b5e20", penwidth=1.6];
    "SOLV-82" [label="SOLV-82\n`apply_allocation` écrit le vecteur 0/1 COMPLET — HiGHS lit ", shape=octagon, color="#1b5e20", penwidth=1.6];
    "SOLV-83" [label="SOLV-83\nLE COÛT DES TROIS LEVIERS EST DU MÊME ORDRE — 0,7 %, 3,7 %, ", shape=ellipse, color="#1b5e20", penwidth=1.6];
    "SOLV-84" [label="SOLV-84\n`read_allocation` porte un repli sur l'ancienne arborescence", shape=box, color="#1b5e20", penwidth=1.6];
  }
  subgraph cluster_VER {
    label="VER"; color="#bdbdbd";
    "VER-01" [label="VER-01\nLes tests unitaires ne lisent JAMAIS les données réelles — e", shape=box, color="#1b5e20", penwidth=1.6];
    "VER-02" [label="VER-02\nLes tests exercent les constructeurs sur des configurations ", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-03" [label="VER-03\n⚠ La suite complète dure ~29 min parce que quelques tests co", shape=octagon, color="#1b5e20", penwidth=1.6];
    "VER-30" [label="VER-30\nLE GOLDEN SNAPSHOT — ~570 sommes de contrôle sur le vrai jeu", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-31" [label="VER-31\nLe golden vit dans `.golden/`, GITIGNORÉ, parce qu'il dérive", shape=box, color="#1b5e20", penwidth=1.6];
    "VER-50" [label="VER-50\n`check_references.py` — le SEUL garde-fou du dépôt sur le so", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-51" [label="VER-51\nSa tolérance est de 5 % PARCE QUE le bruit de branch-and-bou", shape=box, color="#1b5e20", penwidth=1.6];
    "VER-52" [label="VER-52\n⚠ `check_references.py` reste une commande à lancer À LA MAI", shape=cds, color="#01579b", penwidth=1.6];
    "VER-20" [label="VER-20\n`repair_allocation.py` — construire À LA MAIN une solution f", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-21" [label="VER-21\n`constraint_violations` — auditer une graine contre les cont", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-22" [label="VER-22\n`audit_warm_start_seed.py` — chiffrer la DISTANCE d'une grai", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-40" [label="VER-40\n`check_scenario_feasibility.py` — le contrôle avant vol en r", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-41" [label="VER-41\nMesurer le SAUT D'INTÉGRALITÉ en résolvant le même problème ", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-42" [label="VER-42\nLA BISSECTION — retirer les plafonds un par un pour établir ", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-43" [label="VER-43\nÉtablir qu'une politique est HORS D'ATTEINTE demande TROIS c", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-10" [label="VER-10\n`SolveHistory` — le seul relevé empirique du coût de résolut", shape=box, color="#1b5e20", penwidth=1.6];
    "VER-11" [label="VER-11\nL'estimateur refuse de répondre HORS de sa bande de comparab", shape=box, color="#1b5e20", penwidth=1.6];
    "VER-12" [label="VER-12\n`profile_solver.py` — run chronométré par phase sur un sous-", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-13" [label="VER-13\n`shadow_prices.py` — et le piège qu'il documente : figer les", shape=octagon, color="#1b5e20", penwidth=1.6];
    "VER-60" [label="VER-60\n`display_datasets.py` — inspecter le jeu de données sans lan", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-61" [label="VER-61\nUn test de SYNCHRONISATION garde la cohérence entre `config.", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-62" [label="VER-62\n⚠ CE QUI N'EST GARDÉ PAR RIEN — la chaîne solve → generate_r", shape=octagon, color="#01579b", penwidth=1.6];
    "VER-63" [label="VER-63\nLe compte de pages du cœur est vérifié MÉCANIQUEMENT à chaqu", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-B1" [label="VER-B1\nBRANCHE COUPÉE — un run de référence AVEC SOLVE comme garde-", shape=box, color="#b71c1c", penwidth=1.6];
    "VER-32" [label="VER-32\nCe qu'il fallait prouver se réduit à : entrées du solveur et", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-33" [label="VER-33\nLe golden coûte 7 s là où un run avec solve coûte 30 à 55 mi", shape=ellipse, color="#1b5e20", penwidth=1.6];
    "VER-34" [label="VER-34\n`build_model` seul coûte 188 s sur le territoire complet", shape=ellipse, color="#01579b", penwidth=1.6];
    "VER-35" [label="VER-35\nLe piège du mapping des sols a reçu un correctif STRUCTUREL,", shape=component, color="#1b5e20", penwidth=1.6];
    "VER-36" [label="VER-36\nLes tests vérifient LES DEUX BORNES d'un indicateur, pas un ", shape=component, color="#1b5e20", penwidth=1.6];
  }
