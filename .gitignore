__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
/data/
# Historique des durees de solve : local, derive des runs de cette machine.
# Le point initial compte -- ".mosaica_solve_history.json" sans lui n'ignore rien.
.mosaica_solve_history.json
# Resultats de runs : derives de data/ (lui-meme local) et volumineux.
/outputs/
.worktrees/
.claude/*.lock
# Golden snapshot de refactor : derive de data/, reste local
.golden/
# Sources externes (context/). Le GAMS d'origine et l'article de reference SONT versionnes :
# le premier est la reference de parite, le second celle de la methode de calibration. Le
# rapport technique ne l'est pas (binaire volumineux, non diffable).
context/Rapport technique variables MOSAICA_v2.docx
/student_context/
# Memoire : les sources .tex sont versionnees, les produits de compilation non.
memoire/*.aux
memoire/*.log
memoire/*.out
memoire/*.toc
memoire/*.bbl
memoire/*.bcf
memoire/*.blg
memoire/*.run.xml
memoire/*.glo
memoire/*.gls
memoire/*.glg
memoire/*.ist
memoire/*.lof
memoire/*.lot
memoire/memoire.pdf
